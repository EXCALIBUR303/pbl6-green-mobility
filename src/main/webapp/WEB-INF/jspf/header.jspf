<%@ page import="com.woxsen.greenmobility.model.Student" %>
<%
    Student navStudent = (Student) session.getAttribute("student");
    String ctx = request.getContextPath();

    // Pages may set a "mainClass" request attribute before including this file to
    // opt out of the standard centred container (the login page goes full-bleed).
    String mainClass = request.getAttribute("mainClass") != null
            ? (String) request.getAttribute("mainClass")
            : "container pb-5";

    String currentPage = request.getServletPath();
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle != null ? pageTitle : "Campus Green Mobility" %></title>

    <%-- Motion gate. Elements that app.js animates in have to start invisible,
         but hard-coding that in the stylesheet would leave them invisible for
         good if scripting is off or a script 404s. So the hidden state hangs off
         this class, which only ever gets added BY script, and a failsafe timer
         tears it back off if the entrance animation never runs. Net effect: the
         login form is impossible to get stuck hidden. Inline and first in <head>
         so it is applied before the browser's first paint (no flash). --%>
    <script>
      (function () {
        var d = document.documentElement;
        d.classList.add("js-anim");
        setTimeout(function () { d.classList.remove("js-anim"); }, 2000);
      })();
    </script>

    <%-- All third-party assets are vendored under /vendor so the app renders
         correctly with no internet connection (see README). --%>
    <link rel="stylesheet" href="<%= ctx %>/vendor/fonts/plus-jakarta-sans.css">
    <link rel="stylesheet" href="<%= ctx %>/vendor/bootstrap/bootstrap.min.css">
    <link rel="stylesheet" href="<%= ctx %>/vendor/bootstrap-icons/bootstrap-icons.min.css">
    <link rel="stylesheet" href="<%= ctx %>/css/style.css">

    <%-- motion.dev v13 (UMD, the standalone vanilla build — not the React entry
         point, which needs a bundler). Attaches to window.Motion, and is the
         only animation engine in the app. Deliberately NOT deferred: app.js is a
         plain script at the end of <body>, so loading it here is what guarantees
         the global exists by the time app.js runs. --%>
    <script src="<%= ctx %>/vendor/motion/motion.min.js"></script>
</head>
<body>
<% if (navStudent != null) { %>
<nav class="navbar navbar-expand-lg navbar-dark bg-forest shadow-sm mb-4">
    <div class="container">
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="<%= ctx %>/availability.jsp">
            <span class="brand-mark"><i class="bi bi-ev-front-fill"></i></span>
            Campus Green Mobility
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                <% if (navStudent.isAdmin()) { %>
                <li class="nav-item">
                    <a class="nav-link <%= currentPage.contains("adminDashboard") ? "active" : "" %>"
                       href="<%= ctx %>/adminDashboard.jsp">
                        <i class="bi bi-speedometer2 me-1"></i>Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= currentPage.contains("adminSlots") ? "active" : "" %>"
                       href="<%= ctx %>/adminSlots.jsp">
                        <i class="bi bi-calendar2-plus me-1"></i>Manage Slots
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= currentPage.contains("adminFeedback") ? "active" : "" %>"
                       href="<%= ctx %>/adminFeedback.jsp">
                        <i class="bi bi-chat-square-text me-1"></i>Feedback Inbox
                    </a>
                </li>
                <% } else { %>
                <li class="nav-item">
                    <a class="nav-link <%= currentPage.contains("availability") ? "active" : "" %>"
                       href="<%= ctx %>/availability.jsp">
                        <i class="bi bi-calendar2-week me-1"></i>Browse Slots
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= currentPage.contains("history") ? "active" : "" %>"
                       href="<%= ctx %>/history.jsp">
                        <i class="bi bi-graph-up-arrow me-1"></i>My Impact
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= currentPage.contains("rewards") ? "active" : "" %>"
                       href="<%= ctx %>/rewards.jsp">
                        <i class="bi bi-gift me-1"></i>Rewards
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= currentPage.contains("leaderboard") ? "active" : "" %>"
                       href="<%= ctx %>/leaderboard.jsp">
                        <i class="bi bi-trophy me-1"></i>Leaderboard
                    </a>
                </li>
                <% } %>
                <li class="nav-item dropdown ms-lg-2">
                    <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#"
                       data-bs-toggle="dropdown">
                        <span class="avatar-circle"><%= navStudent.getName().substring(0, 1).toUpperCase() %></span>
                        <span class="d-none d-lg-inline"><%= navStudent.getName() %></span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li class="dropdown-header">
                            <div class="fw-semibold text-dark"><%= navStudent.getName() %></div>
                            <div class="small text-muted"><%= navStudent.getEmail() %></div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <% if (!navStudent.isAdmin()) { %>
                        <li>
                            <span class="dropdown-item-text small">
                                <i class="bi bi-cloud-check text-success me-1"></i>
                                <strong><%= navStudent.getTotalCo2SavedKg() %> kg</strong> CO2 saved
                            </span>
                        </li>
                        <li>
                            <span class="dropdown-item-text small">
                                <i class="bi bi-star-fill text-warning me-1"></i>
                                <strong><%= navStudent.getPointsBalance() %> pts</strong> earned
                            </span>
                        </li>
                        <% if (navStudent.getFreeRideCredits() > 0) { %>
                        <li>
                            <span class="dropdown-item-text small">
                                <i class="bi bi-gift-fill text-success me-1"></i>
                                <strong><%= navStudent.getFreeRideCredits() %></strong> free ride voucher<%= navStudent.getFreeRideCredits() == 1 ? "" : "s" %>
                            </span>
                        </li>
                        <% } %>
                        <li><hr class="dropdown-divider"></li>
                        <% } %>
                        <li>
                            <a class="dropdown-item text-danger" href="<%= ctx %>/logout.jsp">
                                <i class="bi bi-box-arrow-right me-1"></i>Log out
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>
<% } %>
<main class="<%= mainClass %>">
